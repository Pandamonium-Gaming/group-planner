{
  "name": "aoc-guild-profession-planner",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "node scripts/generate-migration-list.js && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "prisma generate && jest",
    "test:watch": "prisma generate && jest --watch",
    "test:coverage": "prisma generate && jest --coverage",
    "check:copilot": "node scripts/validate-copilot-compliance.js",
    "update-ships": "node scripts/fetch-ships.js",
    "update-loaners": "tsx scripts/fetch-loaner-matrix.ts --apply",
    "update-loaners:preview": "tsx scripts/fetch-loaner-matrix.ts",
    "check:translations": "node scripts/check-translations.js",
    "check:changelog": "node scripts/check-changelog.js",
    "check:version": "node scripts/check-version-bump.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:rehearse": "node --env-file=.env.local --env-file=.env.rehearsal scripts/rehearse-postgres.mts",
    "db:check-standalone": "node scripts/check-standalone.mts",
    "version:bump": "node scripts/version-bump.js",
    "version:patch": "node scripts/version-bump.js patch",
    "version:minor": "node scripts/version-bump.js minor",
    "version:major": "node scripts/version-bump.js major",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.2.0",
    "cspell": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "prisma": "^7.10.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53"
}
